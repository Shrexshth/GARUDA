# GAURDA Backend Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS="*"

# Path Configurations (Absolute or relative to backend root)
# If left empty, sensible defaults within the backend directory will be used
ROUTING_CONFIG_PATH=""
TEMPLATES_DIR=""
OUTPUTS_DIR=""

# Sandbox Configuration
SANDBOX_TIMEOUT_SECONDS=5.0

# Default Fallback Models (Used if routing.yaml is missing or corrupt)
DEFAULT_OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_VISION_MODEL="llava:7b"
DEFAULT_REASONING_MODEL="mistral"
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"
